@page "/books/{Id}"
@inject LibraryState Library
@inject ProfileService Profiles
@inject ToastService Toasts

<PageTitle>@PageTitleText - Kütüphane Ödünç Takip</PageTitle>

<a class="back-link" href="books">← Kitaplara dön</a>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (!loaded)
{
    <p class="loading" role="status">Yükleniyor...</p>
}
else if (book is null)
{
    <div class="not-found">
        <h1>Kitap bulunamadı</h1>
        <p>Aradığınız kitap listede yok. Adres yanlış yazılmış olabilir.</p>
        <a class="btn btn-primary" href="books">Kitap listesine dön</a>
    </div>
}
else
{
    <BookDetails Book="book" HasActiveLoan="Library.HasActiveLoan(book.Id)" OnBorrowClick="OpenForm" />

    @if (result is not null)
    {
        @* tabindex="-1": kutu Tab sırasına girmez ama koddan odaklanabilir. *@
        <div @ref="resultBox" tabindex="-1"
             class="alert @(result.Success ? "alert-success" : "alert-danger") result"
             role="@(result.Success ? "status" : "alert")">
            @if (result.Success && result.Loan is not null)
            {
                <p class="result-title">Kitap ödünç alındı.</p>
                <dl class="result-facts">
                    <dt>Ödünç kodu</dt>
                    <dd class="code">@result.Loan.Id</dd>
                    <dt>Son teslim tarihi</dt>
                    <dd>@result.Loan.DueDate.ToString("dd.MM.yyyy")</dd>
                </dl>
                <a href="my-loans">Ödünç kayıtlarıma git</a>
            }
            else
            {
                @result.Message
            }
        </div>
    }

    @if (showForm)
    {
        @if (Profiles.Profile is null)
        {
            <p class="profile-hint">
                Bilgilerinizin otomatik dolması için <a href="profile">profil oluşturabilirsiniz</a>.
            </p>
        }
        <BorrowForm Initial="ProfileAsForm" OnSubmit="BorrowAsync" OnCancel="CloseForm" />
    }
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private bool loaded;
    private string? errorMessage;
    private Book? book;
    private bool showForm;
    private ActionResult? result;

    private string PageTitleText =>
        book is not null ? book.Title
        : loaded ? "Kitap bulunamadı"
        : "Kitap";

    // Profil varsa ödünç formu bu bilgilerle dolu açılır (#41).
    private BorrowFormModel? ProfileAsForm => Profiles.Profile is { } p
        ? new BorrowFormModel { FullName = p.FullName, Email = p.Email }
        : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Library.InitializeAsync();
            await Profiles.InitializeAsync();
            loaded = true;
        }
        catch (Exception)
        {
            errorMessage = "Kitap bilgileri yüklenemedi. Sayfayı yenileyip tekrar deneyin.";
        }
    }

    // OnInitializedAsync bittikten sonra, ve adres başka bir kitaba değiştiğinde (sayfa yeniden oluşturulmadan) çalışır.
    protected override void OnParametersSet()
    {
        if (!loaded)
            return;

        book = Library.Books.FirstOrDefault(b => string.Equals(b.Id, Id, StringComparison.OrdinalIgnoreCase));
        showForm = false;
        result = null;
    }

    private void OpenForm()
    {
        result = null;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private async Task BorrowAsync(BorrowFormModel form)
    {
        result = await Library.BorrowAsync(book!.Id, form);
        Toasts.Show(result);
        showForm = false;
        focusResult = true;
    }

    // Form kapanınca odaklanan eleman ekrandan kalkıyor ve odak sayfanın başına düşüyordu.
    // Klavye kullanıcısı sonuca ve "Ödünç kayıtlarıma git" linkine doğrudan ulaşsın diye odak sonuca taşınır.
    private ElementReference resultBox;
    private bool focusResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusResult)
        {
            focusResult = false;
            await resultBox.FocusAsync();
        }
    }
}
