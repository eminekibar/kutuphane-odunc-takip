@page "/my-loans"
@implements IDisposable
@inject LibraryState Library
@inject ProfileService Profiles
@inject TimeProvider Time
@inject ToastService Toasts

<PageTitle>Ödünç Kayıtlarım - Kütüphane Ödünç Takip</PageTitle>

<h1>Ödünç Kayıtlarım</h1>
<p class="lead-text">Ödünç aldığınız kitapları buradan uzatabilir ve iade edebilirsiniz.</p>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (!loaded)
{
    <p class="loading" role="status">Yükleniyor...</p>
}
else if (Library.Loans.Count == 0)
{
    <div class="empty">
        <p>Henüz ödünç kaydınız yok.</p>
        <a class="btn btn-primary" href="books">Kitaplara göz at</a>
    </div>
}
else
{
    @if (feedback is not null)
    {
        @* tabindex="-1": kutu Tab sırasına girmez ama koddan odaklanabilir. *@
        <div @ref="feedbackBox" tabindex="-1"
             class="alert @(feedback.Success ? "alert-success" : "alert-danger") feedback"
             role="@(feedback.Success ? "status" : "alert")">
            @feedback.Message
        </div>
    }

    @* Filtre sadece profil varsa anlamlı: "benim" e-postası profildeki e-posta. *@
    @if (Profiles.Profile is not null)
    {
        <div class="filter" role="group" aria-label="Kayıtları filtrele">
            <button type="button" class="filter-option filter-all @(onlyMine ? "" : "selected")"
                    aria-pressed="@(onlyMine ? "false" : "true")" @onclick="() => onlyMine = false">
                Tüm kayıtlar
            </button>
            <button type="button" class="filter-option filter-mine @(onlyMine ? "selected" : "")"
                    aria-pressed="@(onlyMine ? "true" : "false")" @onclick="() => onlyMine = true">
                Sadece benim kayıtlarım
            </button>
        </div>
    }

    @if (VisibleLoans.Count == 0)
    {
        <p class="filter-empty">Bu e-postayla alınmış kayıt yok.</p>
    }
    else
    {
        <section class="loan-section current" aria-labelledby="current-heading">
            <h2 id="current-heading">Güncel kayıtlar</h2>
            @if (CurrentLoans.Count == 0)
            {
                <p class="section-empty">Şu an iade etmeniz gereken bir kitap yok. <a href="books">Kitaplara göz atın.</a></p>
            }
            else
            {
                <ul class="loan-list">
                    @foreach (var loan in CurrentLoans)
                    {
                        <li @key="loan.Id">
                            <LoanStatus Loan="loan" BookTitle="@TitleOf(loan)" Today="Today"
                                        OnExtend="ExtendAsync" OnReturn="ReturnAsync" />
                        </li>
                    }
                </ul>
            }
        </section>

        @if (PastLoans.Count > 0)
        {
            <section class="loan-section history" aria-labelledby="history-heading">
                <h2 id="history-heading">Geçmiş</h2>
                <ul class="loan-list">
                    @foreach (var loan in PastLoans)
                    {
                        <li @key="loan.Id">
                            <LoanStatus Loan="loan" BookTitle="@TitleOf(loan)" Today="Today" />
                        </li>
                    }
                </ul>
            </section>
        }
    }
}

@code {
    private bool loaded;
    private string? errorMessage;
    private ActionResult? feedback;

    private bool onlyMine;

    private DateTime Today => Time.GetLocalNow().Date;

    // "Sadece benim kayıtlarım" seçiliyse profildeki e-postayla alınmış kayıtlar.
    // E-posta büyük/küçük harf duyarsız karşılaştırılır: AYSE@ornek.com ile ayse@ornek.com aynı adres.
    private List<Loan> VisibleLoans => onlyMine && Profiles.Profile is { } profile
        ? Library.Loans
            .Where(l => string.Equals(l.Email?.Trim(), profile.Email.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList()
        : Library.Loans.ToList();

    // Teslim tarihi en yakın olan (ve gecikmiş olan) en üstte.
    private List<Loan> CurrentLoans => VisibleLoans
        .Where(l => l.ReturnedAt is null)
        .OrderBy(l => l.DueDate)
        .ToList();

    // En son iade edilen en üstte.
    private List<Loan> PastLoans => VisibleLoans
        .Where(l => l.ReturnedAt is not null)
        .OrderByDescending(l => l.ReturnedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        Library.OnChange += HandleStateChanged;

        try
        {
            await Library.InitializeAsync();
            await Profiles.InitializeAsync();
            loaded = true;
        }
        catch (Exception)
        {
            errorMessage = "Ödünç kayıtları yüklenemedi. Sayfayı yenileyip tekrar deneyin.";
        }
    }

    private string TitleOf(Loan loan) =>
        Library.Books.FirstOrDefault(b => b.Id == loan.BookId)?.Title ?? $"Bilinmeyen kitap ({loan.BookId})";

    private async Task ExtendAsync(string loanId)
    {
        feedback = await Library.ExtendAsync(loanId);
        Toasts.Show(feedback);
        focusFeedback = true;
    }

    private async Task ReturnAsync(string loanId)
    {
        feedback = await Library.ReturnAsync(loanId);
        Toasts.Show(feedback);
        focusFeedback = true;
    }

    // İade edilen kart Geçmiş'e taşınıyor, uzatılan kartın butonu pasif oluyor; iki durumda da
    // odaklanan buton kayboluyor ve odak sayfanın başına düşüyordu. Odak mesaja taşınır.
    private ElementReference feedbackBox;
    private bool focusFeedback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusFeedback)
        {
            focusFeedback = false;
            await feedbackBox.FocusAsync();
        }
    }

    // OnChange başka bir bileşenden de tetiklenebilir; InvokeAsync çizimi Blazor'un kendi akışına alır.
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Library.OnChange -= HandleStateChanged;
    }
}
