@implements IDisposable
@inject ProfileService Profiles

@* NavLink'in ürettiği <a> bu bileşenin scoped CSS niteliğini almıyor; stil kapsayıcı div üzerinden ::deep ile veriliyor. *@
<div class="profile-badge">
    @* aria-label kullanılmıyor: ekranda görünen yazı ("AY Ayşe Yılmaz") okunan adın içinde geçmeliydi (WCAG 2.5.3, #67).
       Okunan ad linkin içeriğinden oluşuyor; avatar aria-hidden olduğu için atlanıyor, "Profilim: " öneki sadece ekran okuyucuya. *@
    <NavLink href="profile">
        <span class="avatar @(Profile is null ? "no-profile" : null)" aria-hidden="true">
            @if (Profile is null)
            {
                <span class="person-icon"></span>
            }
            else
            {
                @Profile.Initials
            }
        </span>
        @if (Profile is not null)
        {
            <span class="visually-hidden">Profilim: </span>
        }
        <span class="name">@(Profile?.FullName ?? "Profil oluştur")</span>
    </NavLink>
</div>

@code {
    private UserProfile? Profile => Profiles.Profile;

    protected override async Task OnInitializedAsync()
    {
        Profiles.OnChange += HandleProfileChanged;
        await Profiles.InitializeAsync();
    }

    // Profil sayfasında kaydedilince ya da silinince menüdeki alan da güncellensin.
    private void HandleProfileChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Profiles.OnChange -= HandleProfileChanged;
    }
}
