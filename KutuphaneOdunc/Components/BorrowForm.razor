@* class EditForm'a değil kapsayıcı div'e veriliyor: <form> etiketini EditForm ürettiği için
   BorrowForm'un scoped CSS niteliğini almıyor, .borrow-form kuralı ona uygulanmıyordu. *@
<div class="borrow-form">
    <EditForm Model="model" OnValidSubmit="SubmitAsync" novalidate>
        <DataAnnotationsValidator />

        <h2 class="form-title">Ödünç alma bilgileri</h2>

        <div class="field">
            <label for="borrow-fullname">Ad soyad</label>
            <InputText id="borrow-fullname" class="form-control" autocomplete="name" @bind-Value="model.FullName" />
            <ValidationMessage For="() => model.FullName" />
        </div>

        <div class="field">
            <label for="borrow-email">E-posta</label>
            <InputText id="borrow-email" type="email" class="form-control" autocomplete="email" @bind-Value="model.Email" />
            <ValidationMessage For="() => model.Email" />
        </div>

        <p class="note">Teslim süresi ödünç alma tarihinden itibaren 14 gündür.</p>

        <div class="buttons">
            <button type="submit" class="btn btn-primary">Ödünç Al</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">Vazgeç</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<BorrowFormModel> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    // Verilirse form bu bilgilerle dolu açılır (ör. profilden). Kullanıcı yine değiştirebilir.
    [Parameter]
    public BorrowFormModel? Initial { get; set; }

    private readonly BorrowFormModel model = new();

    // Değerler formun kendi modeline kopyalanır; verilen nesne formda yazılanlarla değişmez.
    // Sadece form ilk açılırken yapılır, sonradan gelen parametre kullanıcının yazdıklarını silmesin.
    protected override void OnInitialized()
    {
        if (Initial is not null)
        {
            model.FullName = Initial.FullName;
            model.Email = Initial.Email;
        }
    }

    // Sadece bütün doğrulamalar geçince çağrılır (OnValidSubmit).
    private Task SubmitAsync() => OnSubmit.InvokeAsync(model);
}
